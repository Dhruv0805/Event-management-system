# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/event_management_system

# Testing only: set to "true" (or run `npm run dev:memdb`) to use a
# temporary in-memory MongoDB instead of MONGO_URI above. No persistent
# data, no local/Atlas MongoDB required. Leave "false" for normal use.
USE_IN_MEMORY_DB=false

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
